# DEV ONLY — For production, use 1Password secret references (op://) instead of literal values.

# Database
DATABASE_URL=postgres://torrenttrader:password@localhost:5432/torrenttrader?sslmode=disable
POSTGRES_PORT=5432
POSTGRES_DB=torrenttrader
POSTGRES_USER=torrenttrader
POSTGRES_PASSWORD=password

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# Session Store
SESSION_STORE=redis
ACCESS_TOKEN_TTL=1h
REFRESH_TOKEN_TTL=720h

# Server
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# JWT
JWT_SECRET=change-me-in-production

# MinIO / S3
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=torrenttrader
S3_USE_SSL=false
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=torrenttrader

# Cache
# STATS_CACHE_TTL=30s

# Worker
ENABLE_SCHEDULER=true
# How long read notifications are kept before the maintenance job purges them.
# Set to 0 to disable the purge entirely.
# NOTIFICATION_RETENTION=2160h

# Database Backups (admin panel → Backups)
# Directory pg_dump files are written to. Must be writable by the backend process.
BACKUP_DIR=./backups
# pg_dump binary. Leave as-is to resolve it from PATH; must be >= the server's major version.
# PG_DUMP_PATH=pg_dump
# Hard limit for a single pg_dump run.
# BACKUP_TIMEOUT=30m
# How many backup files to keep. After a successful backup, older files beyond
# this count are deleted. 0 keeps everything.
# BACKUP_RETENTION=0
# Cron spec for automatic backups (e.g. "0 3 * * *" = daily at 03:00).
# Empty disables scheduled backups. Requires ENABLE_SCHEDULER=true.
# BACKUP_SCHEDULE_CRON=

# Mail
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@torrenttrader.local
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Site URLs
SITE_BASE_URL=http://localhost:5173
API_URL=http://localhost:8080

# Frontend
VITE_API_URL=http://localhost:8080

# Migration Tool (source database - legacy TorrentTrader MySQL)
MIGRATION_SOURCE_DSN=mysql://root:password@localhost:3306/torrenttrader_legacy
MIGRATION_TARGET_DSN=postgres://torrenttrader:password@localhost:5432/torrenttrader?sslmode=disable
