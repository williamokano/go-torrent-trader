# ============================================================================
# TorrentTrader — Stack Environment Variables
#
# Copy this file and fill in the REQUIRED values before deploying.
# In Portainer: paste these into the stack's "Environment variables" section.
# ============================================================================

# --- REQUIRED (no defaults, stack will fail without these) ---

# Database password for PostgreSQL
POSTGRES_PASSWORD=change-me-strong-password

# MinIO root password (min 8 characters)
# The backend S3 credentials are derived from this automatically.
MINIO_ROOT_PASSWORD=change-me-minio-password

# --- OPTIONAL (sensible defaults provided) ---

# Image tag — set to a version like "0.1.0" for pinned deploys
# IMAGE_TAG=latest

# --- Ports ---
# BACKEND_PORT=8080
# FRONTEND_PORT=3000

# --- Reverse proxy ---
# Address the reverse proxy connects from — comma-separated CIDRs or bare IPs.
# Required if a proxy sits in front: without it every request is recorded as
# coming from the proxy, which breaks IP bans and the sessions list. Only
# requests whose direct peer is in this list have their X-Forwarded-For header
# trusted. Keep it as narrow as possible — every address in it counts as
# infrastructure, never a client. For the stack it is the compose bridge
# gateway; find it with `docker network inspect`. Leave unset with no proxy.
# TRUSTED_PROXIES=172.16.0.0/12

# --- Site ---
# SITE_NAME=TorrentTrader
# SITE_DESCRIPTION=Private BitTorrent Tracker
# SITE_BASE_URL=http://localhost:3000
# API_URL=http://localhost:8080

# --- Database ---
# POSTGRES_DB=torrenttrader
# POSTGRES_USER=torrenttrader
# DB_MAX_OPEN_CONNS=25
# DB_MAX_IDLE_CONNS=5
# DB_CONN_MAX_LIFETIME=5m

# --- Sessions ---
# SESSION_STORE=redis
# ACCESS_TOKEN_TTL=1h
# REFRESH_TOKEN_TTL=720h

# --- Storage ---
# STORAGE_TYPE=s3
# MINIO_ROOT_USER=minioadmin
# S3_BUCKET=torrenttrader

# --- SMTP ---
# SMTP_HOST=mailpit
# SMTP_PORT=1025
# SMTP_FROM=noreply@torrenttrader.local

# --- Tracker ---
# TRACKER_ANNOUNCE_INTERVAL=1800
# TRACKER_MIN_INTERVAL=900
# TRACKER_MAX_PEERS=50

# --- Worker ---
# ENABLE_SCHEDULER=true

# --- Database Backups (admin panel → Backups) ---
# Backups are written to the backup_data volume (/app/backups in the container).
# Hard limit for a single pg_dump run.
# BACKUP_TIMEOUT=30m
# How many backup files to keep (0 = keep everything).
# BACKUP_RETENTION=7
# Cron spec for automatic backups, e.g. "0 3 * * *" (daily at 03:00).
# Empty disables scheduled backups. Requires ENABLE_SCHEDULER=true.
# BACKUP_SCHEDULE_CRON=0 3 * * *

# --- Logging ---
# LOG_LEVEL=info
